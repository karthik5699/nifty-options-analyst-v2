# NIFTY 50 Options Research Analyst - Environment Configuration Template
# Copy this file OUTSIDE the repository (e.g. ~/.config/nifty_analyst/config.env)
# and restrict permissions: chmod 600 ~/.config/nifty_analyst/config.env
# NEVER commit real credentials, tokens, account IDs, or phone numbers.

# Operating mode: OFFLINE or LIVE_MORNING_SNAPSHOT
NIFTY_ANALYST_MODE=OFFLINE

# Path to external chmod-600 secret env file (optional if variables set in environment)
NIFTY_ANALYST_SECRET_FILE=

# Kotak Neo Read-Only Broker Configuration [UNVERIFIED SDK INTERFACE]
KOTAK_API_ROOT=
KOTAK_CONSUMER_KEY=PLACEHOLDER_DO_NOT_COMMIT
KOTAK_SESSION_TOKEN=PLACEHOLDER_DO_NOT_COMMIT
KOTAK_SID=PLACEHOLDER_DO_NOT_COMMIT
# Provisional unverified serial request interval (seconds). Default 2.5s.
# Any HTTP 429 stops the run immediately with zero retries.
KOTAK_MIN_REQUEST_INTERVAL_SECONDS=2.5

# Optional Live Data File Overrides (defaults to bundled fixtures/ when unset)
NIFTY_ANALYST_HOLIDAYS_PATH=
NIFTY_ANALYST_EOD_ARCHIVE_PATH=
NIFTY_ANALYST_EVENTS_PATH=
NIFTY_ANALYST_PAYOFF_CHART_DIR=

# Multi-expiry evaluation & intraday alert deduplication
EVALUATE_ALL_ACTIVE_EXPIRIES=true
DEDUPLICATE_INTRADAY_ALERTS=true
MAX_LOTS_PER_TRADE=1

# Single-Pass Persona Synthesis Configuration (Zero paid API spend authorized by default; zero multicall)
# Supported providers: offline_deterministic, ollama, vllm, hosted_api, agent_artifact
# agent_artifact = WhatsApp / operator LLM agent seam: exports a compact sanitised
# Desk Brief + TradingAgents persona pack (Bull/Bear/Vol Debate, Risk Triad, Consolidator),
# loads the single-pass JSON artifact, and verifies every citation deterministically.
LLM_PROVIDER=offline_deterministic
AGENT_SYNTHESIS_ARTIFACT_PATH=
LLM_MODEL_ID=qwen2.5:14b-instruct
LLM_ENDPOINT_URL=http://127.0.0.1:11434/api/generate

# Paid LLM Spend Guard (MUST remain false unless trader explicitly authorizes budget)
ALLOW_PAID_LLM_SPEND=false
MAX_TOKENS_PER_RUN=4000
MAX_COST_PER_RUN_INR=0.0
HOSTED_LLM_COST_PER_1K_TOKENS_INR=0.0
HOSTED_LLM_API_KEY=PLACEHOLDER_DO_NOT_COMMIT

# Risk & Pricing Parameters (No STT: technical & options analysis drive suggestions)
RISK_FREE_RATE_ANNUAL=0.0675
SLIPPAGE_BUFFER_POINTS_PER_LEG=0.50
BROKERAGE_PER_ORDER_RS=20.0
MAX_QUOTE_STALENESS_SECONDS=180
